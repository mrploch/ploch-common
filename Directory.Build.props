<?xml version="1.0" encoding="utf-8"?>

<Project>
    <PropertyGroup>
        <Authors>Kris Ploch</Authors>
        <Company>Ploch</Company>
        <Product>Ploch.Common</Product>
        <PackageProjectUrl>https://common.github.ploch.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mrploch/ploch-common.git</RepositoryUrl>
        <Description>Common utility libraries.</Description>
        <Copyright>Kris Ploch $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-Recommended</AnalysisLevel>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <!-- Versioning is handled by Nerdbank.GitVersioning (version.json) -->
        <!-- SourceLink: enables source debugging for consumers -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Deterministic builds for CI -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <IsTestProject>$(MSBuildProjectName.EndsWith('Tests'))</IsTestProject>
        <!-- Every shipping library lives under src/. Used to scope IsPackable below. -->
        <_PlochSourceRoot>$(MSBuildThisFileDirectory)src</_PlochSourceRoot>
        <!--
            Nothing under tests/ ever ships. Used to default IsPackable off below.
            No trailing directory separator, matching $(_PlochSourceRoot) above: this is
            compared with StartsWith against $(MSBuildProjectDirectory), which uses '\' on
            Windows and '/' on the Linux CI runners, so hard-coding either one would
            silently stop matching on the other platform. The cost is that a sibling
            directory whose name merely starts with "tests" (a hypothetical
            tests-integration/) would also match; that fails safe - it would make a project
            unpackable, never packable - and $(_PlochSourceRoot) has the same shape. See #343
            for hardening both with [MSBuild]::EnsureTrailingSlash.
        -->
        <_PlochTestRoot>$(MSBuildThisFileDirectory)tests</_PlochTestRoot>
        <NoWarn>$(NoWarn);NU1507;CS9057;NU1603</NoWarn>
        <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>
    <PropertyGroup Condition="$(IsTestProject)">
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <!--
        Shipping libraries under src/ state IsPackable explicitly.
        Without it the property is left empty here, and NuGet.Build.Tasks.Pack.targets
        later applies its own default:
            <IsPackable Condition="'$(IsPackable)'=='' AND ('$(IsTestProject)'=='true' OR '$(IsTestingPlatformApplication)'=='true')">false</IsPackable>
        Any library that references xUnit v3 (the Ploch.TestingSupport.XUnit3 family) inherits
        IsTestingPlatformApplication=true from the Microsoft.Testing.Platform build props, so the
        SDK silently marked those shipping packages non-packable. See issue #280.

        The $(_PlochSourceRoot) guard leaves IsPackable empty everywhere else, so the SDK default
        above decides. That is NOT enough on its own: $(IsTestProject) is only a project-name
        heuristic, and the group below sets IsTestProject=false for anything not named *Tests.
        With both halves of the SDK condition false, the empty IsPackable falls through to NuGet's
        general '' -> true default instead, and GeneratePackageOnBuild=true is set here as well - so
        a test fixture not named *Tests packs and publishes. That is exactly what happened to
        tests/TestAssemblies/Common.Tests.TestTypes (issue #279); its two siblings escaped only
        because they hard-code IsPackable=false in their own .csproj.

        The $(_PlochTestRoot) group further below changes the default for the whole tests/ tree,
        so a future fixture cannot repeat this by being named the wrong thing. It is a default,
        not a lock: this file is imported before the .csproj, so a project under tests/ that sets
        IsPackable=true itself still wins. That is deliberate - the failure mode here is a fixture
        packing by accident, not one opting in on purpose - and the ./tests/* filter in both
        publish workflows would still keep such a package off the feeds.

        Test projects keep IsPackable=false via the $(IsTestProject) group above, and any project
        that opts out explicitly in its own .csproj still wins, because this file is imported first.
    -->
    <PropertyGroup Condition="!$(IsTestProject)">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTestProject>false</IsTestProject>
        <IsPackable Condition="$(MSBuildProjectDirectory.StartsWith('$(_PlochSourceRoot)'))">true</IsPackable>
    </PropertyGroup>
    <!--
        Nothing under tests/ is packed by default - not the *Tests projects, and not the
        fixture assemblies under tests/TestAssemblies/ that exist only to be loaded by them.

        This group MUST stay after the !$(IsTestProject) group above, which sets
        GeneratePackageOnBuild=true for every project not named *Tests. Ordering is the whole
        point: MSBuild takes the last assignment, so moving this earlier would let that group
        switch package generation back on.

        IsTestProject is deliberately left alone here. Flipping it to true for the whole tree
        would pull the test-project tooling (coverage collectors and the like) into the plain
        fixture assemblies, which is a different change with different consequences.
    -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(_PlochTestRoot)'))">
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
    <!--
        Optional MSBuild settings dump. Set `-p:PrintBuildSettings=true` on the dotnet CLI
        (or define the property in a Directory.Build.props override) to enable it for a
        targeted diagnostic build. Off by default so CI logs stay readable.
        Also guarded against IDE design-time builds (IntelliSense/restore passes) so the
        diagnostic dump never spams the IDE output even if the opt-in is set globally.
    -->
    <Target Name="PrintSettings" BeforeTargets="Build" Condition="'$(PrintBuildSettings)' == 'true' And '$(DesignTimeBuild)' != 'true'">
        <Message Text="Building $(MSBuildProjectName) with settings:" Importance="high" />
        <Message Text="MSBuildProjectName -> '$(MSBuildProjectName)'" Importance="high" />
        <Message Text="Configuration -> '$(Configuration)' " Importance="high" />
        <Message Text="DebugType -> '$(DebugType)' " Importance="high" />
        <Message Text="DebugSymbols -> '$(DebugSymbols)' " Importance="high" />
        <Message Text="AssemblyName -> '$(AssemblyName)' " Importance="high" />
        <Message Text="IsTestProject -> '$(IsTestProject)' " Importance="high" />
        <Message Text="GeneratePackageOnBuild -> '$(GeneratePackageOnBuild)' " Importance="high" />
        <Message Text="GenerateDocumentationFile -> '$(GenerateDocumentationFile)' " Importance="high" />
        <Message Text="IsPackable -> '$(IsPackable)' " Importance="high" />
    </Target>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>
    <!-- Nerdbank.GitVersioning and SourceLink for all projects -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    </ItemGroup>
    <!--
        Inject Coverlet's MSBuild instrumentation into every test project so
        `dotnet test /p:CollectCoverage=true` produces an OpenCover report.
        Without this, the CI coverage flag is a silent no-op for any test
        project missing a manual coverlet.msbuild reference, and SonarCloud
        reports artificially low coverage. See issue #217.
    -->
    <ItemGroup Condition="$(IsTestProject)">
        <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    </ItemGroup>
</Project>
