<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
          CS1591 (missing XML comment for publicly visible type or member) is disabled for this project only.
          Every member here is a machine-generated icon-font glyph constant produced by IconFont2Code
          (see IconFonts/*.cs). There are roughly twelve thousand of them, each one carrying no information
          beyond the glyph code point it already holds, so per-member documentation would add noise rather
          than meaning and would swamp the build log. The types themselves remain documented.
        -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageVersion Update="Roslynator.Analyzers" Version="4.12.11" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Roslynator.Analyzers">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <PackageVersion Update="SonarAnalyzer.CSharp" Version="10.6.0.109712" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="SonarAnalyzer.CSharp">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>
